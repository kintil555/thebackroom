{
	"schemaVersion": 1,
	"id": "backrooms",
	"version": "${version}",
	"name": "Backrooms",
	"description": "Blok bertema Backrooms: Screw Piles, Ceiling, Lamp, Wallpaper, dan Carpet.",
	"authors": [
		"Backrooms Mod"
	],
	"license": "MIT",
	"icon": "assets/backrooms/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.backrooms.BackroomsMod"
		],
		"client": [
			"com.backrooms.client.BackroomsClient"
		],
		"lambdynlights:initializer": [
			"com.backrooms.compat.LdlCompat"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"seamlessportals": "*"
	},
	"mixins": [
		"backrooms.mixins.json",
		{
			"config": "backrooms.client.mixins.json",
			"environment": "client"
		}
	]
}
